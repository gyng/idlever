/* copy:label */
const LABEL = {
	weights: "tactics",
	orders: "orders",
	temperament: "temperament",
	workers: "workers",
	pen: "pen"
};
/* copy:tooltip */
const TIP = {
	weights: "packages worn · how he fights",
	orders: "standing orders · run setup, Legacy, ranks",
	temperament: "optional temperament orders · selected at departure",
	workers: "hired hands · chores while away",
	pen: "own rules · written by hand"
};
/* copy:callout */
const FALLBACK = {
	weights: "second stance",
	orders: "first supplies",
	temperament: "survivor stage",
	workers: "first hire",
	pen: "meet Mother"
};
/* copy:callout */
const RETIRES = {
	weights: "each move",
	orders: "each send",
	temperament: "manual adaptation",
	workers: "town chores",
	pen: "package limits"
};
const trigger = (L, id) => L.systems?.find((s) => s.id === id && !s.open)?.trigger;
/** what lit an open system: the core's `lit_by` (Cut 118 §6: its trigger, `time`, or `feat: …`), else its trigger */
const litBy = (L, id) => {
	const s = L.systems?.find((x) => x.id === id && x.open);
	return s?.lit_by ?? s?.trigger;
};
