+/// Steady's learned recovery must act with an empty pack, while unsafe/critical exits keep priority.
+#[test]
+fn learned_steady_recovers_before_its_dry_exit_only_when_safe() {
+    for (runs, hp, poison, recover) in [(10, 35, false, true), (40, 35, false, true),
+        (10, 35, true, false), (0, 35, false, false), (10, 20, false, false)] {
+        let mut g = Game::new_resident(7);
+        g.lineage.pkg.runs.insert("steady".into(), runs);
+        crate::packages::recompile(&mut g.lineage);
+        g.send();
+        let r = g.run.as_mut().unwrap();
+        r.monsters.clear();
+        r.hero.inv.retain(|item| item.kind != "heal");
+        r.hero.max_hp = 100;
+        r.hero.hp = hp;
+        r.hero.energy = 100;
+        if poison { r.hero.poison = (1, 100); }
+        g.tick();
+        let r = g.run.as_ref().unwrap();
+        if recover {
+            assert!(r.hero.hp > hp, "L2+ heals a safely recoverable empty-pack hero");
+            assert!(r.homeward.is_none() && r.over.is_none(), "safe recovery precedes the dry exit");
+        } else {
+            assert!(r.homeward.is_some() || r.over.is_some(), "unsafe, unlearned or critical recovery keeps the exit");
+            assert!(r.hero.hp <= hp, "the hero did not rest");
+        }
+    }
+}
