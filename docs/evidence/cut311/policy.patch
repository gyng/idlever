 struct CounterCopy { boss: String, rows: Vec<Row> }
 
+// Only stat_probe configures this experiment; canonical dayplayer ignores env flags.
+static PEN_POLICY: std::sync::OnceLock<&'static str> = std::sync::OnceLock::new();
+pub fn configure_pen_policy(name: &str) -> Result<(), String> {
+    install_pen_policy(&PEN_POLICY, name)
+}
+fn install_pen_policy(cell: &std::sync::OnceLock<&'static str>, name: &str) -> Result<(), String> {
+    let name = match name {
+        "original" => "original",
+        "lich-boss-only" => "lich-boss-only",
+        _ => return Err("invalid experimental pen policy".into()),
+    };
+    cell.set(name).map_err(|_| "pen policy already installed".into())
+}
+fn pen_policy_name() -> &'static str {
+    PEN_POLICY.get_or_init(|| "original")
+}
+fn selected_counter_rows(boss: &str, heal: i32, boss_only: bool) -> Vec<Row> {
+    idlever_core::packages::drill_rows(boss, heal).into_iter()
+        .filter(|row| !(boss_only && boss == "lich"
+            && row.verb == idlever_core::rules::Verb::arg("attack", "tag:summoned")))
+        .collect()
+}
+
+#[cfg(test)]
+mod cut311_tests {
+    use super::*;
+    #[test]
+    fn cut311_boss_only_preserves_the_exact_companion_and_other_bosses() {
+        for heal in [25, 35, 45] {
+            let original = idlever_core::packages::drill_rows("lich", heal);
+            assert_eq!(original.len(), 2);
+            assert_eq!(selected_counter_rows("lich", heal, false), original);
+            assert_eq!(selected_counter_rows("lich", heal, true), vec![original[1].clone()]);
+            for boss in ["bloat_mother", "foundry_master", "lurker_queen", "mirror_king"] {
+                assert_eq!(selected_counter_rows(boss, heal, true), idlever_core::packages::drill_rows(boss, heal));
+            }
+        }
+    }
+    #[test]
+    fn cut311_policy_configuration_rejects_unknown_and_second_installation() {
+        let cell = std::sync::OnceLock::new();
+        assert!(install_pen_policy(&cell, "typo").is_err());
+        assert!(cell.get().is_none());
+        assert!(install_pen_policy(&cell, "original").is_ok());
+        assert!(install_pen_policy(&cell, "lich-boss-only").is_err());
+        assert_eq!(cell.get(), Some(&"original"));
+    }
+}
