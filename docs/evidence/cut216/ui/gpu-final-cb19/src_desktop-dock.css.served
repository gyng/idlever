const __vite__css = "/* Primary resource meaning stays accessible beside its familiar gold icon/$.\n   Legacy and best depth retain their text labels. */\nhtml body .topbar .gold > .resource-label {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n@media (min-width: 1024px) {\n  html body main.frame > .console {\n    justify-self: center;\n    inline-size: max-content;\n    max-inline-size: calc(100% - 1rem);\n    border-width: 12px;\n    margin-block-end: 8px;\n  }\n  html body main.frame > .console .console-row {\n    margin: 0;\n    max-inline-size: 100%;\n    grid-template-columns: 72px minmax(0, 1fr) 5rem;\n    gap: 12px;\n  }\n  html body main.frame.camp > .console .console-row {\n    grid-template-columns: minmax(0, 1fr) 5rem;\n  }\n  html body main.frame > .console .cmd {\n    max-inline-size: none;\n    inline-size: min(74vw, calc(var(--dock-count, 8) * 5.25rem));\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 4.5rem), 5.25rem));\n    grid-auto-rows: minmax(4.5rem, auto);\n    gap: 6px;\n  }\n  html body main.frame > .console .cmd .tile.empty:not(.tile-gap) {\n    display: none;\n  }\n  html body main.frame .console .cmd .tile {\n    min-inline-size: 44px;\n    min-block-size: 44px;\n    box-sizing: border-box;\n  }\n  html body main.frame .console .cmd .tile .tl {\n    font-size: 0.875rem;\n    line-height: 1.2;\n    white-space: normal;\n    overflow-wrap: anywhere;\n  }\n  html body main.frame > .console .portrait {\n    inline-size: 72px;\n    block-size: 72px;\n  }\n  html body main.frame > .console .gem {\n    inline-size: 5rem;\n    min-inline-size: 5rem;\n    block-size: 5rem;\n    font-size: 1rem;\n  }\n\n  html body main.frame.watch.floating-controls .stage > .console {\n    position: absolute;\n    inset: auto var(--watch-dock-right, 104px) 8px auto;\n    z-index: 10;\n    inline-size: max-content;\n    max-inline-size: calc(100% - var(--watch-dock-right, 104px) - 8px);\n    border-width: 12px;\n    padding: 0;\n    margin: 0;\n  }\n  html body main.frame.watch.floating-controls .console-row {\n    margin: 0;\n    grid-template-columns: 72px minmax(0, 1fr) 5rem;\n    gap: 12px;\n  }\n  html body main.frame.watch.floating-controls .console .cmd {\n    max-inline-size: none;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n  html body main.frame.watch.floating-controls .console .cmd .tile {\n    inline-size: 5.25rem;\n    min-block-size: 4.5rem;\n  }\n  html body main.frame.watch.floating-controls .console .portrait {\n    inline-size: 72px;\n    block-size: 72px;\n  }\n  html body main.frame.watch.floating-controls .console .gem {\n    inline-size: 5rem;\n    min-inline-size: 5rem;\n    block-size: 5rem;\n    font-size: 1rem;\n  }\n  html body main.frame.watch.floating-controls .watch-messages {\n    bottom: calc(var(--watch-dock-h, 0px) + 20px);\n  }\n}\n"
