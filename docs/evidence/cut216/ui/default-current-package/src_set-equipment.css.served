const __vite__css = "/* Set equipment inherits the Forge iron or Bloodlines ink material. */\n.set-equipment,\n.set-collection,\n.set-family,\n.set-bonuses,\n.set-intent,\n.set-slot {\n  display: grid;\n  gap: var(--ui-space-2);\n  min-inline-size: 0;\n  overflow-wrap: anywhere;\n}\n.set-equipment,\n.set-collection {\n  gap: var(--ui-space-3);\n}\n.set-family,\n.set-slot {\n  padding: var(--ui-space-3);\n  border: 2px solid var(--ui-edge);\n  background: var(--ui-inset);\n}\n.set-family :is(h3, h4, p),\n.set-slot :is(h3, h4, p) {\n  margin: 0;\n}\n.set-family h3,\n.set-slot summary {\n  color: var(--ui-text);\n  font-size: var(--ui-body);\n}\n.set-counts,\n.set-actions,\n.set-slot-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--ui-space-2);\n  min-inline-size: 0;\n}\n.set-equipment :is(button, summary, select, input),\n.set-collection :is(button, summary, select, input) {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  max-inline-size: 100%;\n  white-space: normal;\n  overflow-wrap: anywhere;\n}\n.set-equipment :is(button, select, input):focus-visible,\n.set-collection :is(button, select, input):focus-visible {\n  outline: 3px solid var(--ui-focus);\n  outline-offset: 2px;\n}\n.set-bonus {\n  padding-inline-start: var(--ui-space-2);\n  border-inline-start: 3px solid var(--ui-edge);\n  color: var(--ui-text);\n}\n.set-bonus[data-active=\"true\"] {\n  border-inline-start-color: var(--ui-selected);\n}\n.set-bonus-status,\n.set-pin-status {\n  font-size: var(--ui-body);\n  color: var(--ui-text);\n}\n.set-piece-choice[aria-pressed=\"true\"],\n.set-follow-choice[aria-pressed=\"true\"] {\n  border-color: var(--ui-selected);\n}\n.set-equipment-slots,\n.set-pieces,\n.set-piece,\n.set-source-focus {\n  display: grid;\n  gap: var(--ui-space-2);\n  min-inline-size: 0;\n}\n.set-equipment-line {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--ui-space-2);\n}\n.set-pieces {\n  gap: var(--ui-space-3);\n}\n.set-family :is(button, summary):hover:not(:disabled) {\n  border-color: var(--ui-focus);\n}\n.set-family button:active:not(:disabled) {\n  box-shadow: inset 0 2px 3px var(--ink);\n}\n.set-family:focus-visible {\n  outline: 3px solid var(--ui-focus);\n  outline-offset: 2px;\n}\n.set-bonus {\n  display: grid;\n  gap: var(--ui-space-1);\n}\n"
