import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/hero-hub.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/g/p/riddle/web/src/hero-hub.css"
const __vite__css = ".hero-hub {\n  container-type: inline-size;\n  container-name: hero-navigation;\n  overflow-wrap: anywhere;\n  display: grid;\n  gap: 1rem;\n  min-width: 0;\n  color: var(--ui-text, #eadfc5);\n}\n.hero-hub :is(h2, h3, p) {\n  margin: 0;\n}\n.hero-hub :is(button, small, strong, span, h2, h3) {\n  overflow-wrap: anywhere;\n}\n.hero-hub button {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  max-width: 100%;\n  white-space: normal;\n}\n.hero-hub-header {\n  display: grid;\n  grid-template-columns: 72px minmax(0, 1fr);\n  gap: 0.5rem;\n  padding: 0.5rem;\n  border-bottom: 2px solid var(--ui-edge, #b89448);\n}\n/* At 200% root text every rem gap doubles while the face keeps its 72 CSS px, so on a narrow hub the\n   identity column collapsed to ~60px and its own words hung 3px out of the window. From 8rem of hub\n   width down the block takes its own row under the face — `rem`, so bigger text reaches the threshold at\n   a wider viewport, the same font-relative convention as the tab rules below. */\n@container hero-navigation (max-width: 8rem) {\n  .hero-hub-header {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n.hero-hub-face {\n  width: 72px;\n  height: 88px;\n  background-repeat: no-repeat;\n  border: 1px solid var(--ui-edge, #b89448);\n  display: grid;\n  place-items: center;\n}\n.hero-hub-face img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: 50% 30%;\n}\n/* The short identity values pack onto shared lines (the name and the training fold keep their own row), so\n   a 200% header is a few wrapped lines instead of one line per value. */\n.hero-hub-identity {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0.125rem 0.5rem;\n  min-width: 0;\n}\n.hero-hub-identity > * {\n  min-inline-size: 0;\n}\n.hero-hub-identity > h2,\n.hero-hub-identity > [data-hub-training] {\n  flex: 1 0 100%;\n}\n/* Cut256: the fold keeps a 44 CSS px target instead of the material's font-scaled 2.75rem height (88px at\n   a 200% root font), like the Hub's other controls. */\n.hero-hub .hero-hub-identity [data-hub-training] > summary {\n  display: flex;\n  align-items: center;\n  min-block-size: 44px;\n  padding-block: 4px 5px;\n  cursor: pointer;\n}\n.hero-hub-secondary,\n.hero-hub-residents {\n  grid-column: 1/-1;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n}\n.hero-hub-tabs {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n.hero-hub-tab[aria-selected=\"true\"] {\n  border-color: var(--ui-edge, #b89448);\n  color: #ffdfa4;\n  box-shadow: inset 0 -3px #b89448;\n}\n.hero-hub button:hover:not(:disabled) {\n  filter: brightness(1.18);\n}\n.hero-hub button:active:not(:disabled) {\n  filter: brightness(0.92);\n}\n.hero-hub :is(button, summary, input):focus-visible {\n  outline: 2px solid #ffdfa4;\n  outline-offset: 3px;\n}\n.hero-hub-content,\n.hero-hub-panel {\n  min-width: 0;\n}\n.hero-hub-panel {\n  display: grid;\n  gap: 1rem;\n}\n.hero-hub-panel[hidden] {\n  display: none;\n}\n.hero-hub-doll {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: stretch;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border: 2px solid var(--ui-edge, #b89448);\n  background: radial-gradient(ellipse at 50% 30%, #302b39, #171720 72%);\n}\n/* Cut271: the equipment diagram spans the section; the slot cards (Actual · Next delve) sit under it. */\n.hero-hub-figure {\n  grid-column: 1/-1;\n  min-width: 0;\n  display: grid;\n  justify-items: center;\n}\n.hero-hub-sprite {\n  display: block;\n  max-width: 100%;\n  overflow: hidden;\n  background-repeat: no-repeat;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 8px 3px #000a);\n}\n.hero-hub-silhouette {\n  font-size: 5rem;\n  color: #b89448;\n}\n.hero-hub-gear-anchor {\n  display: grid;\n  align-content: start;\n  gap: 0.4rem;\n  text-align: start;\n}\n.hero-hub .hero-life-panel {\n  padding: 0;\n  overflow: visible;\n  max-height: none;\n}\n.hero-hub .pkg-strip {\n  display: grid;\n  gap: 0.5rem;\n}\n@media (prefers-reduced-motion: reduce) {\n  .hero-hub * {\n    scroll-behavior: auto;\n  }\n}\n\n.hero-hub :is([data-hub-slot-phase], [data-hub-slot-shared]) {\n  display: grid;\n  gap: 0.2rem;\n  border-top: 1px solid #b8944866;\n  padding-top: 0.3rem;\n}\n.hero-hub-totals {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));\n  gap: 1rem;\n}\n.hero-hub-totals article {\n  padding: 0.75rem;\n  border: 1px solid #b8944866;\n  background: #171720;\n}\n.hero-hub-totals dl {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 0.4rem;\n}\n.hero-hub-totals dd {\n  margin: 0;\n  text-align: end;\n  overflow-wrap: anywhere;\n}\n.hero-hub [data-family-phase] {\n  display: block;\n  margin-top: 0.5rem;\n}\n\n.hero-hub :is(input, select, summary) {\n  min-block-size: 44px;\n  min-inline-size: 44px;\n  max-width: 100%;\n}\n.hero-hub summary {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n}\n.hero-hub-totals :is(dt, dd) {\n  min-width: 0;\n}\n\n.hero-hub :is([data-family-descriptors], .hero-trait-card) {\n  display: grid;\n  gap: 0.5rem;\n}\n.hero-hub [data-temperament-phase] {\n  display: block;\n  margin-top: 0.5rem;\n}\n\n.hero-hub-actual-build {\n  display: grid;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border: 1px solid #b8944866;\n  background: #171720;\n}\n.hero-hub-actual-build article {\n  display: grid;\n  gap: 0.35rem;\n}\n\n.hero-hub :is([data-detail-tip], [data-kwh], .kw-on[tabindex=\"0\"]) {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  display: inline-flex;\n  align-items: center;\n  max-width: 100%;\n}\n\n.hero-hub-panel {\n  grid-template-columns: minmax(0, 1fr);\n  container-type: inline-size;\n  container-name: hero-folio;\n}\n.hero-hub\n  :is(\n    .bloodline-loadouts,\n    .starting-kits,\n    .starting-gear,\n    .bloodline-prepared,\n    .bloodline-catalogue,\n    .hero-hub-gear-effects\n  ) {\n  min-width: 0;\n  max-width: 100%;\n  box-sizing: border-box;\n}\n.hero-hub .bloodline-loadouts {\n  grid-template-columns: minmax(0, 1fr);\n}\n.hero-hub-gear-effects article,\n.hero-hub-gear-effects section {\n  display: grid;\n  gap: 0.5rem;\n  min-width: 0;\n  margin-block: 0.75rem;\n}\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  padding: 0.5rem;\n  min-width: 44px;\n}\n/* Font-relative: large text stacks the doll before side cards get cramped. */\n@container hero-folio (max-width:30rem) {\n  .hero-hub-doll {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 0.5rem;\n    padding: 0.5rem;\n    border-width: 1px;\n  }\n  .hero-hub-figure {\n    grid-column: 1;\n  }\n  .hero-hub-sprite {\n    max-width: min(100%, 132px);\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: 1;\n  }\n}\n@container hero-folio (max-width:280px) {\n  .hero-hub-doll,\n  .hero-hub .bloodline-prepared,\n  .hero-hub .bloodline-catalogue {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: 1;\n  }\n}\n@container hero-navigation (max-width:420px) {\n  .hero-hub-tabs {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n@container hero-navigation (max-width:15rem) {\n  .hero-hub-tabs {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* Cut220 visual refinement: quiet slot cards, readable Actual/Next rows, compact tabs. */\n/* Hub controls keep a 44 CSS px target without the material's font-scaled 2.75rem height. */\n.hero-hub .hero-hub-tabs button.hero-hub-tab,\n.hero-hub :is(.hero-hub-secondary, .hero-hub-residents) button.btn,\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  min-block-size: 44px;\n}\n.hero-hub .hero-hub-tabs button.hero-hub-tab {\n  padding: 4px 0.5rem 5px;\n  line-height: 1.2;\n  overflow-wrap: break-word;\n}\n.hero-hub :is(.hero-hub-secondary, .hero-hub-residents) button.btn {\n  padding-block: 4px 5px;\n  line-height: 1.2;\n}\n/* The tablet frame keeps its 8px art border; only the inner padding tightens,\n   leaving the selected control's 3px inset rule clear of the text. */\nhtml.skin-tablet body .game-window[data-material] .hero-hub-tabs button.hero-hub-tab,\nhtml.skin-tablet\n  body\n  .game-window[data-material]\n  :is(.hero-hub-secondary, .hero-hub-residents)\n  button.btn {\n  padding-block: 2px 5px;\n}\n@container hero-navigation (max-width:420px) {\n  .hero-hub-tabs {\n    gap: 0.375rem;\n  }\n}\n\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  gap: 0.3rem;\n  padding: 0.5rem 0.75rem;\n  border: 1px solid #b8944899;\n  background: #222a40;\n  box-shadow: inset 0 1px #a4bcd626;\n  color: var(--ui-text, #eadfc5);\n}\n/* Whole words where they fit; grid children may shrink so a long word breaks, not overflows. */\n.hero-hub .hero-hub-gear-anchor :is(b, small, strong, span) {\n  overflow-wrap: break-word;\n  min-width: 0;\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-slot-name {\n  color: var(--acc, #dbba7c);\n  font-size: var(--ui-detail, 0.875rem);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-item {\n  color: var(--ui-text, #eadfc5);\n  font-weight: 600;\n}\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-shared] > strong,\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase] > strong {\n  color: var(--mist, #a4bcd6);\n  font-weight: 400;\n}\n/* Actual and Next read as two labelled rows; they stack only when the card is too narrow. */\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase] {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  column-gap: 0.5rem;\n  row-gap: 0;\n}\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase] > strong {\n  flex: 0 1 auto;\n  inline-size: min(5.5em, 100%);\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-phase-value {\n  flex: 1 1 min(7em, 100%);\n  min-width: 0;\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-origin::before {\n  content: \" · \";\n}\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase=\"next\"] {\n  border-top-style: dashed;\n}\n\n/* Framed skill buttons keep both text lines inside the frame's inner gilt rule. */\nhtml.skin-button\n  .sheet-body.hero-hub\n  .class-tree-panel\n  button.chip:is(.class-path-choose, .class-path-remove),\nhtml.skin-button .sheet-body.hero-hub .class-style-panel button.chip.class-style-choose {\n  /* Cut266: 12px, not 8px — at 200% text the first and last line boxes touched the frame's inner gilt\n     band (contrast 1.2–3.3 against it at 320 CSS px) */\n  padding-block: 12px;\n}\n@container hero-folio (max-width:280px) {\n  .hero-hub-doll {\n    padding: 0.25rem;\n  }\n  .sheet-body.hero-hub button.hero-hub-gear-anchor {\n    padding-inline: 0.5rem;\n  }\n}\n\n/* Narrow folios stack each Legacy upgrade's button under its text, so copy keeps its width. */\n@container hero-folio (max-width:30rem) {\n  .sheet-body.hero-hub .legacy-tree .legacy-upgrade {\n    grid-template-columns: 32px minmax(0, 1fr);\n  }\n  .sheet-body.hero-hub .legacy-tree button.legacy-buy {\n    grid-column: 1/-1;\n    justify-self: stretch;\n    max-width: none;\n  }\n}\n/* Cut225: the class's abilities in Skills, every rung (reached lit) */\n.hero-hub-abilities {\n  display: grid;\n  gap: 6px;\n  margin: 8px 0;\n}\n.hero-hub-abilities h4 {\n  margin: 0;\n}\n.hero-hub-abilities .ladder {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n}\n/* a rung not yet reached stays readable on the Hub's dark material (the parchment's ink would not) */\n.hero-hub .hero-hub-abilities .chip.rung:not(.on) {\n  color: #cfc5b0;\n  border-color: #4a4f66;\n  background: rgba(23, 22, 34, 0.6);\n}\n\n/* the class name as a title (the wire word is lower case) */\n.hero-hub-class {\n  text-transform: capitalize;\n}\n\n/* Cut271 (owner 2026-10-18, \"More abstract\"): framed slot tiles around a plain silhouette, joined by\n   leader lines. The body is 8 × 16 diagram units (viewBox 100×200); each slot's --doll-y is its tile\n   centre in units, the height its leader line leaves the body's edge (REGIONS in hero-equipment-figure.ts). */\n.hero-equipment-figure {\n  align-content: start;\n  gap: 0.5rem;\n}\n.hero-equipment-phases {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 0.375rem;\n  min-width: 0;\n}\n.hero-equipment-phases button[aria-pressed=\"true\"] {\n  border-color: var(--gilt, #b89448);\n  box-shadow: inset 0 -3px var(--gilt, #b89448);\n  color: var(--bone, #eadfc5);\n}\n.hero-equipment-stage {\n  --doll-u: 1rem;\n  --doll-tile: max(2.75rem, 3.5 * var(--doll-u));\n  position: relative;\n  inline-size: min(100%, 34rem);\n  block-size: calc(18 * var(--doll-u));\n}\n.hero-equipment-body {\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: calc(50% - 4 * var(--doll-u));\n  inline-size: calc(8 * var(--doll-u));\n  block-size: calc(16 * var(--doll-u));\n  display: block;\n  overflow: visible;\n}\n.hero-equipment-leader {\n  stroke: #b8944870;\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n.hero-equipment-joint {\n  fill: #b8944899;\n}\n.hero-equipment-slot {\n  position: absolute;\n  inset-block-start: calc(var(--doll-y) * var(--doll-u) - var(--doll-tile) / 2);\n  inline-size: calc(50% - 4 * var(--doll-u));\n  display: flex;\n  align-items: flex-start;\n}\n.hero-equipment-slot[data-doll-slot=\"helm\"] {\n  --doll-y: 3.5;\n}\n.hero-equipment-slot[data-doll-slot=\"weapon\"] {\n  --doll-y: 11;\n}\n.hero-equipment-slot[data-doll-slot=\"armour\"] {\n  --doll-y: 5;\n}\n.hero-equipment-slot[data-doll-slot=\"boots\"] {\n  --doll-y: 12.5;\n}\n.hero-equipment-slot[data-doll-side=\"start\"] {\n  inset-inline-start: 0;\n}\n.hero-equipment-slot[data-doll-side=\"end\"] {\n  inset-inline-end: 0;\n  flex-direction: row-reverse;\n}\n.hero-equipment-card {\n  display: grid;\n  justify-items: center;\n  gap: 0.25rem;\n  flex: 0 1 auto;\n  min-inline-size: var(--doll-tile);\n  max-inline-size: min(7rem, 100% - 0.5rem);\n}\n.hero-equipment-tile {\n  position: relative;\n  display: grid;\n  place-items: center;\n  inline-size: var(--doll-tile);\n  block-size: var(--doll-tile);\n  box-sizing: border-box;\n  border: 1px solid #b8944899;\n  background: #1c2132;\n  box-shadow: inset 0 0 0 2px #0e111a;\n}\n.hero-equipment-tile > :is(svg, img) {\n  grid-area: 1/1;\n  inline-size: 82%;\n  block-size: 82%;\n  object-fit: contain;\n}\n.hero-equipment-slot[data-doll-art=\"empty\"] .hero-equipment-tile {\n  border-style: dashed;\n  border-color: #b8944866;\n  background: #171a26;\n}\n.hero-equipment-name {\n  max-inline-size: 100%;\n  font-size: var(--ui-detail, 0.875rem);\n  line-height: 1.2;\n  text-align: center;\n  color: var(--ui-text, #eadfc5);\n  overflow-wrap: break-word;\n}\n.hero-equipment-name::first-letter {\n  text-transform: uppercase;\n}\n.hero-equipment-name.is-empty::first-letter {\n  text-transform: none;\n}\n.hero-equipment-name.is-empty {\n  color: #b9b2a3;\n  font-style: italic;\n}\n.hero-equipment-lead {\n  flex: 1 1 0;\n  min-inline-size: 0.5rem;\n  margin-block-start: calc(var(--doll-tile) / 2);\n  border-block-start: 1px solid #b8944870;\n}\n/* A slot that changes between Actual and Next delve: a brighter frame, lead and joint, in both views. */\n.hero-equipment-slot[data-doll-change=\"1\"] .hero-equipment-tile {\n  border: 2px solid #dbba7c;\n}\n.hero-equipment-slot[data-doll-change=\"1\"] .hero-equipment-tile::after {\n  content: \"\";\n  position: absolute;\n  inset-block-start: -5px;\n  inset-inline-end: -5px;\n  inline-size: 8px;\n  block-size: 8px;\n  background: #dbba7c;\n  transform: rotate(45deg);\n}\n.hero-equipment-slot[data-doll-change=\"1\"] .hero-equipment-lead {\n  border-block-start-color: #dbba7c;\n}\n.hero-equipment-leader[data-doll-change=\"1\"] {\n  stroke: #dbba7c;\n}\n.hero-equipment-joint[data-doll-change=\"1\"] {\n  fill: #dbba7c;\n}\n.hero-equipment-tile:focus-visible {\n  outline: 2px solid #ffdfa4;\n  outline-offset: 3px;\n}\n/* A phone folio draws the diagram at three quarters; tiles keep a 44px target. */\n@container hero-folio (max-width:30rem) {\n  .hero-equipment-stage {\n    --doll-u: 0.75rem;\n  }\n}\n/* Too narrow for tiles beside the body (large text on a phone): the slots line up in two columns. */\n@container hero-folio (max-width:17rem) {\n  .hero-equipment-stage {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 0.75rem 0.5rem;\n    block-size: auto;\n  }\n  .hero-equipment-body,\n  .hero-equipment-lead {\n    display: none;\n  }\n  .hero-equipment-slot {\n    position: static;\n    inline-size: auto;\n    justify-content: center;\n  }\n  .hero-equipment-card {\n    max-inline-size: 100%;\n  }\n}\n@container hero-folio (max-width:11rem) {\n  .hero-equipment-stage {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* Cut264 contrast review: the sticky close stud covered the ends of lower gear lines while the\n   window scrolled. Keep navigation outside the folio's scroll area so no text passes beneath it. */\nhtml body .sheet-wrap.centered > .game-window[data-material]:has(> .hero-hub) {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  grid-template-rows: 44px minmax(0, 1fr) 16px;\n  row-gap: 4px;\n  overflow: hidden;\n}\nhtml body .game-window[data-material]:has(> .hero-hub) > :is(.close-stud, .sheet-back) {\n  position: static;\n  grid-row: 1;\n  grid-column: 1;\n  float: none;\n  margin: 0;\n  align-self: center;\n}\nhtml body .game-window[data-material]:has(> .hero-hub) > .close-stud {\n  justify-self: end;\n}\nhtml body .game-window[data-material]:has(> .hero-hub) > .sheet-back {\n  justify-self: start;\n}\nhtml body .game-window[data-material] > .hero-hub {\n  grid-row: 2;\n  grid-column: 1;\n  min-height: 0;\n  overflow: auto;\n  align-content: start;\n  scrollbar-width: thin;\n  scrollbar-color: var(--ui-edge) var(--ui-surface);\n}\nhtml body .sheet-wrap.centered > .game-window[data-material]:has(> .hero-hub)::before {\n  content: none;\n}\nhtml body .sheet-wrap.centered > .game-window[data-material]:has(> .hero-hub)::after {\n  content: \"▾\";\n  position: static;\n  grid-row: 3;\n  grid-column: 1;\n  height: 16px;\n  margin: 0;\n  padding: 0;\n  background: none;\n  color: var(--ui-muted);\n  font: 600 16px/16px var(--sans);\n  text-align: center;\n  visibility: hidden;\n}\nhtml\n  body\n  .sheet-wrap.centered\n  > .game-window[data-material][data-more=\"1\"]:has(> .hero-hub)::after {\n  visibility: visible;\n}\n.hero-hub .hero-hub-tabs {\n  scroll-margin-top: 4px;\n}\n/* One window size for every section: the Attributes tree no longer widens the window (and the others\n   no longer shrink it back), and a short section no longer re-centres the window under the tabs. */\nhtml body .sheet-wrap.centered > .sheet:has(> .hero-hub) {\n  height: calc(100dvh - var(--window-top, 0px) - var(--window-bottom, 0px) - 32px);\n}\n@media (min-width: 900px) {\n  html body .sheet-wrap.centered > .sheet:has(> .hero-hub) {\n    width: min(940px, 100%);\n    max-width: 940px;\n  }\n}\n/* Cut266 review: the Hub's folds are flex rows, which drops the browser's disclosure marker, so `Gear\n   effects`, `Current gear` and the slot folds read as headings. The game's quiet caret marks them. */\n.hero-hub details > summary {\n  cursor: pointer;\n}\n.hero-hub details > summary::-webkit-details-marker {\n  display: none;\n}\n.hero-hub details > summary::before {\n  content: \"▸\";\n  margin-inline-end: 6px;\n  color: var(--acc, #dbba7c);\n}\n.hero-hub details[open] > summary::before {\n  content: \"▾\";\n}\n/* the prepare chips' `Free` / requirement sat flush against the item name (`leashFree`) */\n.hero-hub .bloodline-prepare small {\n  margin-inline-start: 0.35em;\n}\n/* the header's class word matches the Skills title (the wire word is lower case) */\n.hero-hub-identity > span {\n  text-transform: capitalize;\n}\n/* the Legacy wallet over the Attributes tree: count, the next rank it works toward, its share filled */\n.hero-hub-wallet {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0.25rem 0.75rem;\n}\n.hero-hub-wallet small {\n  color: var(--ui-muted, #a4bcd6);\n}\n.hero-hub-wallet .legacy-bar {\n  flex: 1 0 100%;\n}\n/* the Actual pets card: one pet per tight block (default h4 margins left a blank line around each name) */\n.hero-hub-actual-build h4 {\n  margin: 0;\n}\n.hero-hub-actual-build article + article {\n  padding-top: 0.5rem;\n  border-top: 1px solid #b8944833;\n}\n/* the kit name field matches the hero name field (the browser's grey box read as disabled) */\n.hero-hub input[type=\"text\"] {\n  box-sizing: border-box;\n  padding: var(--ui-space-2, 0.5rem);\n  color: var(--ui-text, #eadfc5);\n  background: var(--ui-inset, #171720);\n  border: 2px solid var(--ui-edge, #b89448);\n  font: inherit;\n}\n.hero-hub input::placeholder {\n  color: var(--ui-muted, #a4bcd6);\n  opacity: 1;\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))