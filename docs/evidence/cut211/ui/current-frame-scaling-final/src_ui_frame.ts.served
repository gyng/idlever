			{
				transform: `translate(${(i - 2) * 11}px, 100px) scale(.7)`,
				opacity: 0
			},
			{
				offset: .2,
				opacity: 1
			},
			{
				transform: "translate(0,0) scale(1)",
				opacity: 0
			}
		], {
			duration: 650,
			delay: i * 45,
			easing: "cubic-bezier(.2,.7,.2,1)"
