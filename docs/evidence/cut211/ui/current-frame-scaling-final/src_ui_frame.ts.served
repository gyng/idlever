let atlas = null;
function loadAtlas() {
	atlas ??= fetch(`${import.meta.env.BASE_URL}art/atlas.json`).then((r) => r.json()).then((a) => ({
		frames: a.frames,
		w: a.meta.atlas.w,
		h: a.meta.atlas.h
