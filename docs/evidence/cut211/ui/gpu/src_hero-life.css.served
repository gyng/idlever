const __vite__css = "/* Persistent identity lives in the same ink/gilt material as Bloodlines. */\n.hero-life-panel {\n  display: grid;\n  gap: var(--ui-space-4);\n  min-width: 0;\n  color: var(--ui-text);\n  font-size: var(--ui-body);\n}\n.hero-life-panel :is(p, h2, h3) {\n  margin: 0;\n}\n.hero-life-panel :is(p, h2, h3, span, small, li, button, label) {\n  overflow-wrap: anywhere;\n}\n.hero-life-heading {\n  font: bold var(--ui-title) var(--display);\n}\n.hero-life-state {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--ui-space-2);\n}\n.hero-life-section {\n  display: grid;\n  gap: var(--ui-space-2);\n  min-width: 0;\n  padding: var(--ui-space-3);\n  border: 2px solid var(--ui-edge);\n  background: var(--ui-inset);\n}\n.hero-life-section h3 {\n  font-size: var(--ui-body);\n}\n.hero-life-section p {\n  line-height: 1.5;\n}\n.hero-life-section small {\n  color: var(--ui-muted);\n  font-size: var(--ui-detail);\n}\n.hero-name-form {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--ui-space-2);\n  min-width: 0;\n}\n.hero-name-form label {\n  flex: 1 1 100%;\n}\nhtml body .game-window[data-material=\"bloodlines\"] .hero-life-panel input {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  width: min(100%, 18rem);\n  max-width: 100%;\n  box-sizing: border-box;\n  padding: var(--ui-space-2);\n  color: var(--ui-text);\n  background: var(--ui-inset);\n  border: 2px solid var(--ui-edge);\n  font: inherit;\n}\nhtml body .game-window[data-material=\"bloodlines\"] .hero-life-panel :is(button, summary) {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  max-width: 100%;\n  box-sizing: border-box;\n  white-space: normal;\n}\n.hero-life-panel input:focus-visible {\n  outline: 3px solid var(--ui-focus);\n  outline-offset: 2px;\n}\n.hero-life-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--ui-space-2);\n}\n.hero-life-attributes {\n  display: grid;\n  gap: var(--ui-space-3);\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));\n}\n.hero-life-preview-list {\n  margin: 0;\n  padding-inline-start: 1.25rem;\n  line-height: 1.5;\n}\n.hero-life-feedback {\n  min-height: 1.5em;\n  color: var(--ui-muted);\n  font-size: var(--ui-detail);\n}\n"
