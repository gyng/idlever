import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/legacy.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/g/p/riddle/web/src/legacy.css"
const __vite__css = "/* Bloodline branches share the game's recessed parchment cards and chunky controls. */\n.legacy-tree {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  align-items: start;\n  gap: 14px;\n}\n.legacy-branch {\n  min-width: 0;\n}\n.legacy-branch h3 {\n  margin: 0 0 8px;\n  font: 600 18px/1.3 var(--control-font);\n  color: #675020;\n}\n.game-window .legacy-tree .legacy-upgrade {\n  position: relative;\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr);\n  gap: 8px;\n  min-height: 104px;\n  margin: 0 0 10px;\n  padding: 10px;\n}\n.legacy-tree .legacy-buy {\n  grid-column: 1/-1;\n  justify-self: end;\n  min-height: 44px;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  font-size: 14px;\n  padding: 8px 10px;\n}\n.legacy-tree .legacy-buy small {\n  display: block;\n  margin: 0;\n  font-size: 11px;\n}\n.legacy-icon {\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  padding-top: 2px;\n}\n.legacy-icon .ico {\n  width: 32px;\n  height: 32px;\n  object-fit: contain;\n}\n.legacy-node-name {\n  display: inline-block;\n  cursor: help;\n}\n.legacy-node-name:focus-visible {\n  outline: 2px solid var(--acc);\n  outline-offset: 3px;\n}\n.legacy-tree .chosen {\n  border-color: #9b762d;\n  box-shadow:\n    inset 0 1px 2px #79644955,\n    0 0 0 1px #c39b4d;\n}\n.legacy-tree .locked:not(.owned) {\n  background: linear-gradient(110deg, #dbd2beaa, #b2a48633);\n}\n.legacy-path > summary {\n  margin: 2px 0 10px;\n  cursor: pointer;\n  color: #6f5732;\n  font: 600 15px/1.4 var(--control-font);\n  min-height: 28px;\n}\n.legacy-path .legacy-upgrade::before {\n  content: \"\";\n  position: absolute;\n  width: 2px;\n  height: 10px;\n  background: #a29375;\n  left: 50%;\n  top: -12px;\n}\n.legacy-fork {\n  padding: 0 0 0 8px;\n  border-left: 2px solid #a29375;\n}\n.legacy-fork-label {\n  display: block;\n  margin: 0 0 8px;\n  color: #6f5732;\n  font: 600 13px/1.3 var(--control-font);\n}\n.legacy-footer {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px;\n}\n.legacy-feedback {\n  color: #8b382b;\n  min-height: 1em;\n  font: 400 14px/1.4 var(--body-font);\n}\n@media (min-width: 900px) {\n  body .sheet-wrap.centered > .sheet:has(.legacy-tree) {\n    width: min(940px, 100%);\n    max-width: 940px;\n  }\n}\n@media (max-width: 899px) {\n  .legacy-tree {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n  .game-window .legacy-tree .legacy-upgrade {\n    grid-template-columns: 32px minmax(0, 1fr) auto;\n    min-height: 86px;\n    gap: 8px;\n    padding: 8px;\n  }\n  .legacy-tree .legacy-buy {\n    grid-column: auto;\n    max-width: 110px;\n  }\n  .legacy-fork {\n    margin-left: 16px;\n  }\n  .legacy-path > summary {\n    min-height: 44px;\n    display: flex;\n    align-items: center;\n  }\n  .legacy-path > summary::before {\n    content: \"▸\";\n    margin-right: 6px;\n  }\n  .legacy-path[open] > summary::before {\n    content: \"▾\";\n  }\n}\n/* Cut 122 §9: the next rank — a thin bar under the header's Legacy and the hero window's count */\n.legacy-bar {\n  display: block;\n  height: 3px;\n  min-width: 28px;\n  border-radius: 2px;\n  background: #ffffff22;\n  overflow: hidden;\n}\n.legacy-bar .fill {\n  display: block;\n  height: 100%;\n  background: #d8b45a;\n}\n.topbar .stat.legacy {\n  position: relative;\n}\n.topbar .stat.legacy .legacy-bar {\n  position: absolute;\n  left: 6px;\n  right: 6px;\n  bottom: 2px;\n  min-width: 0;\n}\n.legacy-next {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  max-width: 260px;\n}\n.legacy-next .legacy-bar {\n  background: #00000022;\n  height: 4px;\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))