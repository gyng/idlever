import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/hero-hub.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/g/p/riddle/web/src/hero-hub.css"
const __vite__css = ".hero-hub {\n  container-type: inline-size;\n  container-name: hero-navigation;\n  overflow-wrap: anywhere;\n  display: grid;\n  gap: 1rem;\n  min-width: 0;\n  color: var(--ui-text, #eadfc5);\n}\n.hero-hub :is(h2, h3, p) {\n  margin: 0;\n}\n.hero-hub :is(button, small, strong, span, h2, h3) {\n  overflow-wrap: anywhere;\n}\n.hero-hub button {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  max-width: 100%;\n  white-space: normal;\n}\n.hero-hub-header {\n  display: grid;\n  grid-template-columns: 72px minmax(0, 1fr);\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border-bottom: 2px solid var(--ui-edge, #b89448);\n}\n.hero-hub-face {\n  width: 72px;\n  height: 88px;\n  background-repeat: no-repeat;\n  border: 1px solid var(--ui-edge, #b89448);\n  display: grid;\n  place-items: center;\n}\n.hero-hub-face img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: 50% 30%;\n}\n.hero-hub-identity {\n  display: grid;\n  gap: 0.25rem;\n  min-width: 0;\n}\n.hero-hub-secondary,\n.hero-hub-residents {\n  grid-column: 1/-1;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n}\n.hero-hub-tabs {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n.hero-hub-tab[aria-selected=\"true\"] {\n  border-color: var(--ui-edge, #b89448);\n  color: #ffdfa4;\n  box-shadow: inset 0 -3px #b89448;\n}\n.hero-hub button:hover:not(:disabled) {\n  filter: brightness(1.18);\n}\n.hero-hub button:active:not(:disabled) {\n  filter: brightness(0.92);\n}\n.hero-hub :is(button, summary, input):focus-visible {\n  outline: 2px solid #ffdfa4;\n  outline-offset: 3px;\n}\n.hero-hub-content,\n.hero-hub-panel {\n  min-width: 0;\n}\n.hero-hub-panel {\n  display: grid;\n  gap: 1rem;\n}\n.hero-hub-panel[hidden] {\n  display: none;\n}\n.hero-hub-doll {\n  display: grid;\n  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1.15fr);\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border: 2px solid var(--ui-edge, #b89448);\n  background: radial-gradient(ellipse at 50% 45%, #302b39, #171720 72%);\n}\n.hero-hub-figure {\n  grid-column: 2;\n  grid-row: 2;\n  min-height: 220px;\n  min-width: 0;\n  display: grid;\n  place-items: center;\n}\n.hero-hub-sprite {\n  display: block;\n  max-width: 100%;\n  overflow: hidden;\n  background-repeat: no-repeat;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 8px 3px #000a);\n}\n.hero-hub-silhouette {\n  font-size: 5rem;\n  color: #b89448;\n}\n.hero-hub-gear-anchor {\n  display: grid;\n  align-content: center;\n  align-self: center;\n  gap: 0.4rem;\n  text-align: start;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"helm\"] {\n  grid-column: 1/-1;\n  grid-row: 1;\n  justify-self: center;\n  inline-size: min(100%, 17rem);\n}\n.hero-hub-gear-anchor[data-hub-slot=\"weapon\"] {\n  grid-column: 1;\n  grid-row: 2;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"armour\"] {\n  grid-column: 3;\n  grid-row: 2;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"boots\"] {\n  grid-column: 1/-1;\n  grid-row: 3;\n  justify-self: center;\n  inline-size: min(100%, 17rem);\n}\n.hero-hub .hero-life-panel {\n  padding: 0;\n  overflow: visible;\n  max-height: none;\n}\n.hero-hub .pkg-strip {\n  display: grid;\n  gap: 0.5rem;\n}\n@media (prefers-reduced-motion: reduce) {\n  .hero-hub * {\n    scroll-behavior: auto;\n  }\n}\n\n.hero-hub :is([data-hub-slot-phase], [data-hub-slot-shared]) {\n  display: grid;\n  gap: 0.2rem;\n  border-top: 1px solid #b8944866;\n  padding-top: 0.3rem;\n}\n.hero-hub-totals {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));\n  gap: 1rem;\n}\n.hero-hub-totals article {\n  padding: 0.75rem;\n  border: 1px solid #b8944866;\n  background: #171720;\n}\n.hero-hub-totals dl {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 0.4rem;\n}\n.hero-hub-totals dd {\n  margin: 0;\n  text-align: end;\n  overflow-wrap: anywhere;\n}\n.hero-hub [data-family-phase] {\n  display: block;\n  margin-top: 0.5rem;\n}\n\n.hero-hub :is(input, select, summary) {\n  min-block-size: 44px;\n  min-inline-size: 44px;\n  max-width: 100%;\n}\n.hero-hub summary {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n}\n.hero-hub-totals :is(dt, dd) {\n  min-width: 0;\n}\n\n.hero-hub :is([data-family-descriptors], .hero-trait-card) {\n  display: grid;\n  gap: 0.5rem;\n}\n.hero-hub [data-temperament-phase] {\n  display: block;\n  margin-top: 0.5rem;\n}\n\n.hero-hub-actual-build {\n  display: grid;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border: 1px solid #b8944866;\n  background: #171720;\n}\n.hero-hub-actual-build article {\n  display: grid;\n  gap: 0.35rem;\n}\n\n.hero-hub :is([data-detail-tip], [data-kwh], .kw-on[tabindex=\"0\"]) {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  display: inline-flex;\n  align-items: center;\n  max-width: 100%;\n}\n\n.hero-hub-panel {\n  grid-template-columns: minmax(0, 1fr);\n  container-type: inline-size;\n  container-name: hero-folio;\n}\n.hero-hub\n  :is(\n    .bloodline-loadouts,\n    .starting-kits,\n    .starting-gear,\n    .bloodline-prepared,\n    .bloodline-catalogue,\n    .hero-hub-gear-effects\n  ) {\n  min-width: 0;\n  max-width: 100%;\n  box-sizing: border-box;\n}\n.hero-hub .bloodline-loadouts {\n  grid-template-columns: minmax(0, 1fr);\n}\n.hero-hub-gear-effects article,\n.hero-hub-gear-effects section {\n  display: grid;\n  gap: 0.5rem;\n  min-width: 0;\n  margin-block: 0.75rem;\n}\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  padding: 0.5rem;\n  min-width: 44px;\n}\n/* Font-relative: large text stacks the doll before side cards get cramped. */\n@container hero-folio (max-width:30rem) {\n  .hero-hub-doll {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 0.5rem;\n    padding: 0.5rem;\n    border-width: 1px;\n  }\n  .hero-hub-figure {\n    grid-column: 1;\n    grid-row: 1;\n    min-height: 0;\n  }\n  .hero-hub-sprite {\n    max-width: min(100%, 132px);\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: 1;\n    grid-row: auto;\n    inline-size: auto;\n    justify-self: stretch;\n  }\n}\n@container hero-folio (max-width:280px) {\n  .hero-hub-doll,\n  .hero-hub .bloodline-prepared,\n  .hero-hub .bloodline-catalogue {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: 1;\n  }\n}\n@container hero-navigation (max-width:420px) {\n  .hero-hub-tabs {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n@container hero-navigation (max-width:15rem) {\n  .hero-hub-tabs {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* Cut220 visual refinement: quiet slot cards, readable Actual/Next rows, compact tabs. */\n/* Hub controls keep a 44 CSS px target without the material's font-scaled 2.75rem height. */\n.hero-hub .hero-hub-tabs button.hero-hub-tab,\n.hero-hub :is(.hero-hub-secondary, .hero-hub-residents) button.btn,\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  min-block-size: 44px;\n}\n.hero-hub .hero-hub-tabs button.hero-hub-tab {\n  padding: 4px 0.5rem 5px;\n  line-height: 1.2;\n  overflow-wrap: break-word;\n}\n.hero-hub :is(.hero-hub-secondary, .hero-hub-residents) button.btn {\n  padding-block: 4px 5px;\n  line-height: 1.2;\n}\n/* The tablet frame keeps its 8px art border; only the inner padding tightens,\n   leaving the selected control's 3px inset rule clear of the text. */\nhtml.skin-tablet body .game-window[data-material] .hero-hub-tabs button.hero-hub-tab,\nhtml.skin-tablet\n  body\n  .game-window[data-material]\n  :is(.hero-hub-secondary, .hero-hub-residents)\n  button.btn {\n  padding-block: 2px 5px;\n}\n@container hero-navigation (max-width:420px) {\n  .hero-hub-tabs {\n    gap: 0.375rem;\n  }\n}\n\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  gap: 0.3rem;\n  padding: 0.5rem 0.75rem;\n  border: 1px solid #b8944899;\n  background: #222a40;\n  box-shadow: inset 0 1px #a4bcd626;\n  color: var(--ui-text, #eadfc5);\n}\n/* Whole words where they fit; grid children may shrink so a long word breaks, not overflows. */\n.hero-hub .hero-hub-gear-anchor :is(b, small, strong, span) {\n  overflow-wrap: break-word;\n  min-width: 0;\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-slot-name {\n  color: var(--acc, #dbba7c);\n  font-size: var(--ui-detail, 0.875rem);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-item {\n  color: var(--ui-text, #eadfc5);\n  font-weight: 600;\n}\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-shared] > strong,\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase] > strong {\n  color: var(--mist, #a4bcd6);\n  font-weight: 400;\n}\n/* Actual and Next read as two labelled rows; they stack only when the card is too narrow. */\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase] {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  column-gap: 0.5rem;\n  row-gap: 0;\n}\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase] > strong {\n  flex: 0 1 auto;\n  inline-size: min(5.5em, 100%);\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-phase-value {\n  flex: 1 1 min(7em, 100%);\n  min-width: 0;\n}\n.hero-hub .hero-hub-gear-anchor .hero-hub-origin::before {\n  content: \" · \";\n}\n.hero-hub .hero-hub-gear-anchor [data-hub-slot-phase=\"next\"] {\n  border-top-style: dashed;\n}\n\n/* Framed skill buttons keep both text lines inside the frame's inner gilt rule. */\nhtml.skin-button\n  .sheet-body.hero-hub\n  .class-tree-panel\n  button.chip:is(.class-path-choose, .class-path-remove),\nhtml.skin-button .sheet-body.hero-hub .class-style-panel button.chip.class-style-choose {\n  padding-block: 8px;\n}\n@container hero-folio (max-width:280px) {\n  .hero-hub-doll {\n    padding: 0.25rem;\n  }\n  .sheet-body.hero-hub button.hero-hub-gear-anchor {\n    padding-inline: 0.5rem;\n  }\n}\n\n/* Narrow folios stack each Legacy upgrade's button under its text, so copy keeps its width. */\n@container hero-folio (max-width:30rem) {\n  .sheet-body.hero-hub .legacy-tree .legacy-upgrade {\n    grid-template-columns: 32px minmax(0, 1fr);\n  }\n  .sheet-body.hero-hub .legacy-tree button.legacy-buy {\n    grid-column: 1/-1;\n    justify-self: stretch;\n    max-width: none;\n  }\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
