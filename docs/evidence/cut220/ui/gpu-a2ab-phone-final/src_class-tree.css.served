import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/class-tree.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/g/p/riddle/web/src/class-tree.css"
const __vite__css = "/* Carved branches on the existing parchment; connectors remain crisp at phone scale. */\n.class-tree-panel {\n  margin: 14px 0;\n  padding: 12px;\n  border: 2px solid #94774d;\n  border-radius: 5px;\n  background: linear-gradient(120deg, #e9dfc7, #ccbb98);\n  box-shadow: inset 0 2px 4px #68522c33;\n}\n.class-tree-header,\n.class-tree-soon,\n.class-tree-next {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.class-tree-header {\n  margin-bottom: 10px;\n  font: 600 20px/1.3 var(--control-font);\n}\n.class-tree-header small {\n  font: 400 13px/1.4 var(--body-font);\n}\n.class-tree-soon {\n  padding: 10px 0;\n  border-top: 1px solid #80644255;\n}\n.class-tree-fork {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n.class-path-node {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  min-width: 0;\n  padding: 10px;\n  border: 1px solid #8d744c;\n  border-radius: 4px;\n  background: #f5ead055;\n}\n.class-path-node.chosen {\n  border: 2px solid #81621f;\n  background: #ecdcab88;\n}\n.class-path-heading {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n  font: 600 18px/1.3 var(--control-font);\n}\n.class-path-heading .ico {\n  width: 28px;\n  height: 28px;\n  object-fit: contain;\n}\n.class-path-owned {\n  margin-left: auto;\n  font: 400 12px/1.4 var(--body-font);\n  color: #584b29;\n}\n.class-path-rules {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  font: 400 14px/1.4 var(--body-font);\n  overflow-wrap: anywhere;\n}\n.class-path-rules b {\n  font-weight: 600;\n}\n.class-path-rules small,\n.class-path-blocked {\n  font-size: 12px;\n}\n.class-path-choose {\n  align-self: start;\n  min-height: 44px;\n  margin-top: auto;\n}\n.class-tree-connector {\n  width: 2px;\n  height: 16px;\n  background: #83643b;\n  margin: 0 auto;\n}\n.class-tree-next {\n  padding: 10px 4px;\n  font-size: 14px;\n}\n.class-tree-map,\n.class-tree-alternate {\n  border-top: 1px solid #83643b55;\n  margin-top: 10px;\n  padding-top: 8px;\n}\n.class-tree-map summary,\n.class-tree-alternate summary {\n  min-height: 36px;\n  cursor: pointer;\n  font: 600 16px/1.4 var(--control-font);\n}\n.class-tree-future {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  border-left: 2px solid #967747;\n  padding: 8px;\n  margin: 8px 0 0 8px;\n  font-size: 14px;\n}\n.class-path-remove {\n  margin-top: 10px;\n}\n.class-path-feedback {\n  min-height: 1em;\n  color: #8b382b;\n}\n@media (max-width: 380px) {\n  .class-tree-fork {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 10px;\n  }\n}\n.class-skills-later {\n  margin: 5px 0;\n}\n.class-skills-later summary {\n  cursor: pointer;\n  font-size: 13px;\n  min-height: 28px;\n}\n.class-tree-branch > .class-path-node + .class-path-node {\n  margin-top: 10px;\n}\n.class-tree-next {\n  display: block;\n}\n.class-skill-rules summary {\n  cursor: pointer;\n  min-height: 32px;\n  font-size: 13px;\n}\n.class-reset-skill {\n  display: block;\n  margin: 4px 0;\n}\n/* Leave the fixed close stud room when the tree header scrolls to the frame top. */\n.class-tree-header {\n  padding-right: 32px;\n}\n\n/* Skill actions use the same broad iron-and-gilt button face as class choices. */\nhtml .sheet-body .class-tree-panel button.chip.class-path-choose,\nhtml .sheet-body .class-tree-panel button.chip.class-path-remove,\nhtml .sheet-wrap .sheet-body.class-path-review button.chip,\nhtml .sheet-body .class-style-panel button.chip.class-style-choose,\nhtml .sheet-wrap .sheet-body.class-style-review button.chip {\n  min-height: 56px;\n  justify-content: center;\n  padding: 10px 14px;\n  font-size: 16px;\n  line-height: 1.25;\n  border: 2px solid #55647f;\n  box-shadow:\n    inset 0 2px 0 #a4bcd655,\n    inset 0 -4px 0 #080b13,\n    0 3px 5px #080b1344;\n}\nhtml .sheet-body .class-tree-panel button.chip.class-path-choose {\n  align-self: stretch;\n  width: 100%;\n}\nhtml .sheet-body .class-tree-panel button.chip.class-path-remove {\n  min-width: 148px;\n}\nhtml.skin-button .sheet-body .class-tree-panel button.chip.class-path-choose,\nhtml.skin-button .sheet-body .class-tree-panel button.chip.class-path-remove,\nhtml.skin-button .sheet-wrap .sheet-body.class-path-review button.chip,\nhtml.skin-button .sheet-body .class-style-panel button.chip.class-style-choose,\nhtml.skin-button .sheet-wrap .sheet-body.class-style-review button.chip {\n  border: solid transparent;\n  border-width: 10px 20px;\n  padding: 4px 6px;\n  border-image: url(\"/ui/frames/button.png\") 22 56 22 56 fill / 10px 20px stretch;\n}\n.class-path-node {\n  border-radius: 3px;\n  border-color: #96794d;\n  box-shadow:\n    inset 0 1px 0 #fff7,\n    0 2px 0 #78603e33;\n}\n.class-path-node.chosen {\n  border-color: #8c692b;\n  box-shadow:\n    inset 0 1px 0 #fff7,\n    0 2px 0 #78603e44;\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
