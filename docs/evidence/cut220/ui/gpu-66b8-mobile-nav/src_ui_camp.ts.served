	// Cut 4 §1: `send` waits while the set is over budget (the editor shows which row to drop). Cut 6 §4: it says so: `6/5 · drop one`.
	function paintSend() {
		// QA 308f045 (qaAD: the empty `set 2 · 0` tab tapped, the camp read `death >98% · ~$0` with SEND armed): a set with no rows is no send
		const empty = app.rules.rows.length === 0;
		const homeless = app.lineage.town?.home === false;
		const arriving = performance.now() < residentUntil;
		const recovery = app.lineage.persistent_hero?.recovery_s ?? 0;
		el.classList.toggle("awaiting-home", homeless);
		cons.el.hidden = homeless;
		earlyJournal.hidden = !homeless || !app.lineage.journal;
		restLine.hidden = homeless;
		const campMain = well.querySelector(".camp-main");
		if (campMain) campMain.hidden = homeless || onPackages(app.lineage) && app.lineage.best_depth === 0 && !app.lineage.runs?.length;
		const cleared = app.lineage.ended;
		const recovering = recovery > 0 && !isLive();
		send.disabled = recovering || !cleared && (homeless || arriving || app.overBudget || empty);
		send.classList.toggle("pulse", !cleared && !recovering && !app.overBudget && !empty);
		send.classList.toggle("small", !cleared && (app.overBudget || empty));
		// Speed is chosen once, in the watch. The send gem only sends.
		send.dataset.mode = app.watchMode;
		replace(send, recovering ? `Recovering ${recovery}s` : cleared ? h(
			"span",
			{ class: "send-l" },
			/* copy:button */
			"Next descent"
		) : arriving ? "Hero arriving" : empty ? "no rules" : app.overBudget ? `${app.ownRows()}/${app.vocab.max_rows} · drop one` : h("span", { class: "send-l" }, isLive() ? "Watch" : /* copy:button */ "Delve", sendMark(app.lineage)));
		send.dataset.live = isLive() ? "1" : "0";
		paintTabs();
		if (unlockCat) paintFrom(unlockCat);
	}
	/** Cut 23 §4: a repaint rebuilds the open panel's content — its scroll (and the well's) is kept, so nothing moves under the finger. */
	function keepScroll(fn) {
		const boxes = [
			panelHost.querySelector(".panel-body"),
			panelHost.querySelector(".panel"),
			well
		];
		const tops = boxes.map((b) => b?.scrollTop ?? 0);
		fn();
		boxes.forEach((b, i) => {
			if (b && b.scrollTop !== tops[i]) b.scrollTop = tops[i];
		});
	}
	function paintAll() {
