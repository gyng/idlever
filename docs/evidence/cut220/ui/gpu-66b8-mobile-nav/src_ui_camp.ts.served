			paintStrip();
			paintTiles();
			paintTabs();
			paintStart();
			paintOrders();
			paintDescent();
			paintWall();
			paintRoute();
			paintOath();
			paintSupplies();
			paintUnlocks();
			party.refresh();
			editor.refresh();
			paintSend();
		});
		audio.drone(biomeOf(app.lineage.best_depth + 1));
