	// next edit's first pass ~1 s in wasm — clarity:paint)
	const shownAt = anyNew(app.lineage) && app.engine.seenSystems ? performance.now() : -1;
	const seen = () => {
		if (shownAt >= 0 && performance.now() - shownAt >= SEEN_MS) app.seenPending = true;
	};
	const offLive = app.onLive(() => {
		paintRest();
		if (String(isLive() ? 1 : 0) !== send.dataset.live) paintSend();
	});
	const orderRoute = (anchor) => {
		if (!el.isConnected || !ordersOn() || anchor && !anchor.isConnected) return false;
		openOrders(anchor);
		return true;
	};
	orderRoutes.set(app, orderRoute);
	return {
		el,
		dispose: () => {
			if (orderRoutes.get(app) === orderRoute) orderRoutes.delete(app);
			pick.dispose();
			batch.dispose();
			ladder.dispose();
			feats.dispose();
			offer.dispose();
			window.removeEventListener("idlever:focus-hero", focusHome);
