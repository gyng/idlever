					// QA 92eb880 (N: "`AUTO: RESTOCK · ⊘ ◆1 more` while `$ buy` is enabled"): a marks shortfall the gold covers carries no `⊘`
					h("span", { class: "card-main" }, h("span", null, u.label), u.carries ? h("small", { class: "carries dim" }, u.carries) : "", u.needs ? h("small", { class: "needs dim" }, u.gated && !byGold && !/^\$\d+ more$/.test(u.needs) ? "⊘ " : "", u.needs.replace(/_/g, " ")) : "", d ? h("small", { class: `num delta ${deltaClass(u, d)}` }, deltaLabel(u, d, app.rules.rows.length)) : "", stallLabel(u) ? h("small", { class: "num delta down stall-risk" }, stallLabel(u)) : ""),
