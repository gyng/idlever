import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/hero-hub.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/g/p/riddle/web/src/hero-hub.css"
const __vite__css = ".hero-hub {\n  container-type: inline-size;\n  container-name: hero-navigation;\n  overflow-wrap: anywhere;\n  display: grid;\n  gap: 1rem;\n  min-width: 0;\n  color: var(--ui-text, #eadfc5);\n}\n.hero-hub :is(h2, h3, p) {\n  margin: 0;\n}\n.hero-hub :is(button, small, strong, span, h2, h3) {\n  overflow-wrap: anywhere;\n}\n.hero-hub button {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  max-width: 100%;\n  white-space: normal;\n}\n.hero-hub-header {\n  display: grid;\n  grid-template-columns: 72px minmax(0, 1fr);\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border-bottom: 2px solid var(--ui-edge, #b89448);\n}\n.hero-hub-face {\n  width: 72px;\n  height: 88px;\n  background-repeat: no-repeat;\n  border: 1px solid var(--ui-edge, #b89448);\n  display: grid;\n  place-items: center;\n}\n.hero-hub-face img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: 50% 30%;\n}\n.hero-hub-identity {\n  display: grid;\n  gap: 0.25rem;\n  min-width: 0;\n}\n.hero-hub-secondary,\n.hero-hub-residents {\n  grid-column: 1/-1;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n}\n.hero-hub-tabs {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n.hero-hub-tab[aria-selected=\"true\"] {\n  border-color: var(--ui-edge, #b89448);\n  color: #ffdfa4;\n  box-shadow: inset 0 -3px #b89448;\n}\n.hero-hub button:hover:not(:disabled) {\n  filter: brightness(1.18);\n}\n.hero-hub button:active:not(:disabled) {\n  filter: brightness(0.92);\n}\n.hero-hub :is(button, summary, input):focus-visible {\n  outline: 2px solid #ffdfa4;\n  outline-offset: 3px;\n}\n.hero-hub-content,\n.hero-hub-panel {\n  min-width: 0;\n}\n.hero-hub-panel {\n  display: grid;\n  gap: 1rem;\n}\n.hero-hub-panel[hidden] {\n  display: none;\n}\n.hero-hub-doll {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 1fr);\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border: 2px solid var(--ui-edge, #b89448);\n  background: radial-gradient(ellipse at 50% 45%, #302b39, #171720 72%);\n}\n.hero-hub-figure {\n  grid-column: 2;\n  grid-row: 2;\n  min-height: 220px;\n  min-width: 0;\n  display: grid;\n  place-items: center;\n}\n.hero-hub-sprite {\n  display: block;\n  max-width: 100%;\n  overflow: hidden;\n  background-repeat: no-repeat;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 8px 3px #000a);\n}\n.hero-hub-silhouette {\n  font-size: 5rem;\n  color: #b89448;\n}\n.hero-hub-gear-anchor {\n  display: grid;\n  align-content: center;\n  align-self: center;\n  gap: 0.4rem;\n  text-align: start;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"helm\"] {\n  grid-column: 2;\n  grid-row: 1;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"weapon\"] {\n  grid-column: 1;\n  grid-row: 2;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"armour\"] {\n  grid-column: 3;\n  grid-row: 2;\n}\n.hero-hub-gear-anchor[data-hub-slot=\"boots\"] {\n  grid-column: 2;\n  grid-row: 3;\n}\n.hero-hub .hero-life-panel {\n  padding: 0;\n  overflow: visible;\n  max-height: none;\n}\n.hero-hub .pkg-strip {\n  display: grid;\n  gap: 0.5rem;\n}\n@media (max-width: 600px) {\n  .hero-hub-doll {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .hero-hub-figure {\n    grid-column: 1/-1;\n    grid-row: 1;\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: auto;\n    grid-row: auto;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .hero-hub * {\n    scroll-behavior: auto;\n  }\n}\n\n.hero-hub :is([data-hub-slot-phase], [data-hub-slot-shared]) {\n  display: grid;\n  gap: 0.2rem;\n  border-top: 1px solid #b8944866;\n  padding-top: 0.3rem;\n}\n.hero-hub-totals {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));\n  gap: 1rem;\n}\n.hero-hub-totals article {\n  padding: 0.75rem;\n  border: 1px solid #b8944866;\n  background: #171720;\n}\n.hero-hub-totals dl {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 0.4rem;\n}\n.hero-hub-totals dd {\n  margin: 0;\n  text-align: end;\n  overflow-wrap: anywhere;\n}\n.hero-hub [data-family-phase] {\n  display: block;\n  margin-top: 0.5rem;\n}\n\n.hero-hub :is(input, select, summary) {\n  min-block-size: 44px;\n  min-inline-size: 44px;\n  max-width: 100%;\n}\n.hero-hub summary {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n}\n.hero-hub-totals :is(dt, dd) {\n  min-width: 0;\n}\n\n.hero-hub :is([data-family-descriptors], .hero-trait-card) {\n  display: grid;\n  gap: 0.5rem;\n}\n.hero-hub [data-temperament-phase] {\n  display: block;\n  margin-top: 0.5rem;\n}\n\n.hero-hub-actual-build {\n  display: grid;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border: 1px solid #b8944866;\n  background: #171720;\n}\n.hero-hub-actual-build article {\n  display: grid;\n  gap: 0.35rem;\n}\n\n.hero-hub :is([data-detail-tip], [data-kwh], .kw-on[tabindex=\"0\"]) {\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  display: inline-flex;\n  align-items: center;\n  max-width: 100%;\n}\n\n.hero-hub-panel {\n  grid-template-columns: minmax(0, 1fr);\n  container-type: inline-size;\n  container-name: hero-folio;\n}\n.hero-hub\n  :is(\n    .bloodline-loadouts,\n    .starting-kits,\n    .starting-gear,\n    .bloodline-prepared,\n    .bloodline-catalogue,\n    .hero-hub-gear-effects\n  ) {\n  min-width: 0;\n  max-width: 100%;\n  box-sizing: border-box;\n}\n.hero-hub .bloodline-loadouts {\n  grid-template-columns: minmax(0, 1fr);\n}\n.hero-hub-gear-effects article,\n.hero-hub-gear-effects section {\n  display: grid;\n  gap: 0.5rem;\n  min-width: 0;\n  margin-block: 0.75rem;\n}\n.sheet-body.hero-hub button.hero-hub-gear-anchor {\n  padding: 0.5rem;\n  min-width: 44px;\n}\n@container hero-folio (max-width:420px) {\n  .hero-hub-doll {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .hero-hub-figure {\n    grid-column: 1/-1;\n    grid-row: 1;\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: auto;\n    grid-row: auto;\n  }\n}\n@container hero-folio (max-width:280px) {\n  .hero-hub-doll,\n  .hero-hub .bloodline-prepared,\n  .hero-hub .bloodline-catalogue {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .hero-hub-gear-anchor[data-hub-slot] {\n    grid-column: 1;\n  }\n}\n@container hero-navigation (max-width:420px) {\n  .hero-hub-tabs {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n@container hero-navigation (max-width:15rem) {\n  .hero-hub-tabs {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n"
