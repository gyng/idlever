import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/items.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/g/p/riddle/web/src/items.css"
const __vite__css = "/* Item silhouettes stay unframed; rarity belongs to names and icon metadata. */\n:root {\n  --r-common: #7b776a;\n  --r-uncommon: #4e8763;\n  --r-rare: #4c76b2;\n  --r-epic: #8762a6;\n  --r-masterwork: #a3752a;\n  --r-legendary: #a3752a;\n  --r-common-lit: #b3ad9b;\n  --r-uncommon-lit: #86bc95;\n  --r-rare-lit: #8eafe0;\n  --r-epic-lit: #bf9ad6;\n  --r-masterwork-lit: #e3b862;\n  --r-legendary-lit: #e3b862;\n}\n.r-common {\n  --r: var(--r-common);\n  --r-lit: var(--r-common-lit);\n}\n.r-uncommon {\n  --r: var(--r-uncommon);\n  --r-lit: var(--r-uncommon-lit);\n}\n.r-rare {\n  --r: var(--r-rare);\n  --r-lit: var(--r-rare-lit);\n}\n.r-epic {\n  --r: var(--r-epic);\n  --r-lit: var(--r-epic-lit);\n}\n.r-legendary {\n  --r: var(--r-legendary);\n  --r-lit: var(--r-legendary-lit);\n}\n.r-masterwork {\n  --r: var(--r-masterwork);\n  --r-lit: var(--r-masterwork-lit);\n}\n\n.item-ico {\n  --sz: 34px;\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n  width: var(--sz);\n  height: var(--sz);\n  vertical-align: middle;\n  background: none;\n  border: 0;\n  box-shadow: none;\n  outline: none;\n}\n.item-ico.sz-s {\n  --sz: 22px;\n}\n.item-ico.sz-l {\n  --sz: 48px;\n}\n.item-ico .item-pic {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  image-rendering: auto;\n  filter: drop-shadow(0 1px 1px rgba(13, 12, 20, 0.65));\n}\n.item-ico .item-pic.glyph {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font: 700 calc(var(--sz) * 0.75)/1 var(--display);\n  color: var(--r-lit);\n}\n.sheet .item-ico .item-pic.glyph,\n.panel .item-ico .item-pic.glyph {\n  color: var(--r);\n}\n.item-ico .item-pic.glyph::before {\n  content: attr(data-glyph);\n}\n\n.item-name {\n  color: var(--r-lit);\n  font-weight: 600;\n}\n.parchment .item-name,\n.sheet .item-name,\n.panel .item-name {\n  color: var(--r);\n}\n.item-name.r-common {\n  font-weight: inherit;\n}\n.item-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n.item-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  justify-content: center;\n  align-items: center;\n}\n\n/* Finds keep their one-time arrival animation; no rectangular shine over the silhouette. */\n@media (prefers-reduced-motion: no-preference) {\n  html[data-juice=\"on\"] .item-row.pop .item-ico {\n    animation: r-pop 0.42s cubic-bezier(0.3, 1.6, 0.5, 1) backwards;\n    animation-delay: var(--pop-delay, 0ms);\n  }\n  @keyframes r-pop {\n    from {\n      transform: scale(0.2) rotate(-12deg);\n      opacity: 0;\n      filter: brightness(2);\n    }\n    60% {\n      transform: scale(1.15);\n      opacity: 1;\n    }\n    to {\n      transform: none;\n      filter: none;\n    }\n  }\n}\n.chip .item-ico,\n.item-l .item-ico {\n  margin-right: 5px;\n  vertical-align: -6px;\n}\n\n/* Small item marks keep the map's combat log plain and compact. */\n.item-ico.sz-xs {\n  --sz: 14px;\n  background: transparent;\n  box-shadow: none;\n  border-radius: 0;\n}\n.combat-log .item-ico.sz-xs {\n  margin-right: 3px;\n  vertical-align: -2px;\n}\n.forge-ladders .item-chip {\n  margin-block: 2px;\n}\n.salvage .k .item-chip {\n  display: inline;\n}\n.salvage .k .item-ico {\n  margin-right: 5px;\n}\n\n.supplies .buy-main .item-chip {\n  min-width: 0;\n  max-width: 100%;\n}\n.supplies .buy-main .item-name {\n  white-space: normal;\n  line-height: 1.15;\n}\n\n/* Item names and upgrade counts remain readable on the narrow parchment. */\n.forge .salvage .lrow {\n  grid-template-columns: minmax(0, 1fr) 28px 28px;\n  gap: 2px 8px;\n}\n.forge .salvage .lrow.head > span:nth-child(2) {\n  display: none;\n}\n.forge .salvage .lrow:not(.head) {\n  padding: 6px 0;\n}\n.forge .salvage .k {\n  grid-column: 1;\n  grid-row: 1;\n}\n.forge .salvage .ladder {\n  grid-column: 1;\n  grid-row: 2;\n  margin-left: 27px;\n  white-space: normal;\n  overflow: visible;\n}\n.forge .salvage .dot {\n  grid-row: 1 / span 2;\n}\n.forge .salvage .dot:nth-child(3) {\n  grid-column: 2;\n}\n.forge .salvage .dot:nth-child(4) {\n  grid-column: 3;\n}\n.supplies .buy-main,\n.supplies .buy-title {\n  width: 100%;\n}\n.supplies .buy-title {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  column-gap: 4px;\n}\n.supplies .buy-title > .item-chip {\n  flex: 1 1 100%;\n}\n.supplies .buy-title > .gold {\n  font-size: 12px;\n  line-height: 1.1;\n  margin-left: 27px;\n}\n.supplies .chips.shop > .chip.buy {\n  height: 84px;\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
