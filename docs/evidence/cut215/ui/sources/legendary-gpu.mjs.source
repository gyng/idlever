import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {gunzipSync} from 'node:zlib';
import {createHash} from 'node:crypto';
import {launchGpu} from '../../tools/browser.mjs';
const url='http://127.0.0.1:5296/',out='docs/evidence/cut215/ui/gpu-final';mkdirSync(out,{recursive:true});
const input='docs/evidence/cut215/ui-inputs-final/seed-1/earned-owned-home.game.json.gz',bytes=readFileSync(input),raw=gunzipSync(bytes).toString();
const browser=await launchGpu();const records=[];
try{const page=await browser.newPage();await page.goto(url+'?fresh=1&seed=1&runs=0');await page.waitForFunction(()=>window.__idlever?.booted);
const renderer=await page.evaluate(()=>{const c=document.createElement('canvas'),gl=c.getContext('webgl2'),ext=gl.getExtension('WEBGL_debug_renderer_info');return gl.getParameter(ext.UNMASKED_RENDERER_WEBGL)});assert.match(renderer,/D3D12|NVIDIA/);
async function settle(){await page.evaluate(async()=>{await document.fonts.ready;await Promise.all([...document.images].map(i=>i.decode().catch(()=>{})));const w=document.querySelector('.sheet-wrap:not(.under)');if(w)await Promise.all(w.getAnimations({subtree:true}).filter(a=>Number.isFinite(a.effect.getComputedTiming().endTime)).map(a=>a.finished.catch(()=>{})));});}
for(const width of [400,1440]){await page.setViewportSize({width,height:900});await page.evaluate(async raw=>{const a=window.__idlever;a.runnerOn=false;if(a.kind!=='wasm')throw Error('real package required');a.go({kind:'camp'});await a.engine.load(raw);await a.refresh();a.go({kind:'camp'});},raw);
await page.waitForFunction(()=>!document.querySelector('.sheet-ghost'));const before=await page.evaluate(()=>window.__idlever.engine.save());await page.evaluate(async()=>{(await import('/src/ui/forge.ts')).openForge(window.__idlever)});await settle();assert.equal(await page.evaluate(()=>window.__idlever.engine.save()),before);await page.screenshot({path:`${out}/earned-forge-${width}.png`});
await page.locator('.sheet-wrap:not(.under) [data-legendary-link="crownsplitter"]').click();await settle();assert.equal(await page.evaluate(()=>window.__idlever.engine.save()),before);const gold=await page.evaluate(()=>window.__idlever.lineage.gold);await page.locator('.sheet-wrap:not(.under) [data-kit-choice="crownsplitter"]').click();await page.waitForFunction(()=>window.__idlever.lineage.starting_kits.current?.weapon==='crownsplitter');await settle();assert.equal(await page.evaluate(()=>window.__idlever.lineage.gold),gold);await page.locator('.sheet-wrap:not(.under) [data-kit-choice="crownsplitter"]').evaluate(n=>n.scrollIntoView({block:'center'}));await settle();await page.screenshot({path:`${out}/earned-loadouts-${width}.png`});records.push({width,gold,selected:'crownsplitter',readOnlyLink:true,freeUse:true});}
const source={};for(const p of ['src/ui/forge.ts','src/ui/starting-kits.ts','src/ui/legendary-gear.ts','src/ui/bloodline-loadouts.ts','src/ui/items.ts','src/legendary-gear.css','src/items.css','src/engine/pkg/idlever_wasm_bg.wasm']){const r=await page.request.get(url+p),b=await r.body();source[p]={bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')};if(!p.endsWith('.wasm'))writeFileSync(out+'/'+p.replaceAll('/','_')+'.served',b);}
assert.equal(source['src/engine/pkg/idlever_wasm_bg.wasm'].sha256,'304d9172c430d72c9e9ba24d2db0c475f05071c6b4bc8a2d1521292740429eda');writeFileSync(out+'/results.json',JSON.stringify({renderer,earned:true,performanceClaim:false,input,fixtureSHA:createHash('sha256').update(bytes).digest('hex'),records,source},null,2));console.log(JSON.stringify({result:'PASS',renderer,screenshots:4,records}));}finally{await browser.close();}
