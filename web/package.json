{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fmt": "cd .. && web/node_modules/.bin/oxfmt web/src web/tests web/*.ts web/*.json tools .github README.md .oxfmtrc.json .oxlintrc.json",
    "fmt:check": "pnpm fmt --check",
    "lint": "cd .. && web/node_modules/.bin/oxlint web/src web/tests web/*.ts tools --deny-warnings",
    "lint:fix": "pnpm lint --fix",
    "test": "node tests/run.mjs --smoke",
    "test:full": "node tests/run.mjs --full",
    "test:exhaustive": "node tests/run.mjs --exhaustive"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
